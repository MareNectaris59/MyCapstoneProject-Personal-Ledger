<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 3.3.5.

      HISTORY: this started on 3.2.0 because the offline dependency cache only
      had that version complete. Network access is restored, so 3.3.5 is used
      instead. That upgrade also REMOVED three offline workarounds that are no
      longer needed:
        * spring-boot-starter-validation was pinned to 3.3.5 while the parent
          was 3.2.0 (a cross-version mismatch) - now managed by the parent
        * com.fasterxml:classmate was pinned to 1.7.0 because the version
          managed by 3.2.0 was absent from the cache - now managed
        * commons-pool2 was excluded from spring-boot-starter-data-redis
          because it was absent from the cache - no longer excluded

      Deliberately NOT upgraded beyond 3.x: Spring Boot 4 requires Spring
      Framework 7 and would pull in a large migration for no project benefit.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>personal-ledger</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>personal-ledger</name>
    <description>Personal double-entry bookkeeping and expense analysis system - backend</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <jjwt.version>0.12.3</jjwt.version>
        <!-- springdoc 2.5.x targets Spring Framework 6.1 / Boot 3.3.x -->
        <springdoc.version>2.5.0</springdoc.version>
    </properties>

    <dependencies>
        <!-- Web MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation: @Valid / @NotBlank / @DecimalMin ... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP: @TransactionalEventListener and friends -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring Security: BCrypt password encoding + filter chain.
             Stateless JWT authentication, no session. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Redis: verification codes, refresh tokens, idempotency keys, cache.
             Optional at runtime - CacheService falls back to an in-memory
             implementation when no Redis server is reachable, so the app still
             starts on a machine without Redis. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Mail: registration verification codes, password reset -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Persistence.
             mybatis-plus-boot-starter 3.5.5 transitively brings mybatis-spring
             2.1.x, which is built against Spring 5 and fails on Spring 6 with:
               "Invalid value type for attribute 'factoryBeanObjectType'"
             So the old one is excluded and mybatis-spring 3.0.3 is declared
             explicitly.
             NOTE: unlike the other workarounds in this file, this one is a REAL
             compatibility issue, not an offline-cache workaround. Keep it. -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.mybatis</groupId>
                    <artifactId>mybatis-spring</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <version>3.0.3</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Database migrations.
             Migration scripts belong in src/main/resources/db/migration as
             V<n>__<name>.sql. The current schema also ships as db/schema.sql so
             it can be applied by hand or by spring.sql.init. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger UI at /swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      ======================================================================
      可移植性：让项目拷到任何机器上都能构建
      ======================================================================

      背景：本项目最初为了绕开沙箱限制，在 settings.xml 里写死了
        <localRepository>D:\m2repo</localRepository>
      那是绝对路径 —— 换台电脑、换个盘符、拷进 U 盘就失效。

      现在改为两条路，都不依赖绝对路径：

        默认（推荐）
          用 Maven 标准仓库 %USERPROFILE%\.m2\repository。
          IDEA 和命令行行为一致，无需任何额外配置。
          首次构建需要联网下载依赖（Boot 3.3.5 全套约 200-400 MB）。

        离线便携（U 盘 / 无网机器）
          把预热好的仓库放在项目根目录下的 .m2-portable\，
          下面的 profile 会自动激活并把 localRepository 指向它。
          路径用 ${maven.multiModuleProjectDirectory}（Maven 自动注入的
          项目根目录）拼出来，所以拷到哪个盘都能用。

      要生成可离线携带的仓库，在联网机器上执行：
          mvn -B -Dmaven.repo.local=".m2-portable" dependency:go-offline
    -->
    <profiles>
        <profile>
            <id>portable-offline-repo</id>
            <activation>
                <!-- 只有当项目根目录下存在 .m2-portable 时才生效 -->
                <file>
                    <exists>${maven.multiModuleProjectDirectory}/.m2-portable</exists>
                </file>
            </activation>
            <properties>
                <maven.repo.local>${maven.multiModuleProjectDirectory}/.m2-portable</maven.repo.local>
            </properties>
        </profile>
    </profiles>

</project>
