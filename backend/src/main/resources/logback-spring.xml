<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置。

  设计文档 §8.3 要求「结构化日志、按天滚动、保留 30 天」以及
  「日志中禁止打印密码、令牌、完整邮箱」。这里落实前两项：
    * 控制台输出带 traceId（来自 TraceIdFilter 写入的 MDC）
    * 文件输出按天 + 按大小滚动，保留 30 天，总量上限 1GB

  注意：本项目用原生 logback-spring.xml 而不是 application.yml 的
  logging.* 配置，是因为需要同时挂两个 appender 并分别设定滚动策略。
-->
<configuration>

    <!--
        LOG_DIR 默认是相对路径 logs，**相对于启动时的工作目录**：
          - 从项目根 `java -jar backend/target/...jar`  ->  根/logs
          - 从 backend 目录启动                        ->  backend/logs
          - IDEA 里跑（工作目录通常是 backend）        ->  backend/logs
        这会导致日志散落在不同位置。启动日志里会打印解析后的绝对路径，
        排查时以那一行为准；需要固定位置就设环境变量 LOG_DIR。
    -->
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-}] %logger{40} - %msg%n"/>

    <!-- 控制台 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件：按天滚动，保留 30 天 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/personal-ledger.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/personal-ledger.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!--
        业务包的日志级别**不在这里配**，而是 application.yml 的
        logging.level.com.example.ledger（那里支持 ${APP_LOG_LEVEL:INFO}）。
        原因：Spring Boot 的 logging.level.* 优先级高于 logback 的 <logger>，
        两边都写会让人以为改了这里就生效，实际没有 —— 这个坑刚踩过。
    -->

    <!-- 排查鉴权问题时打开，可以看到每个请求的过滤链决策 -->
    <!-- <logger name="org.springframework.security" level="DEBUG"/> -->

    <!-- Redis 未安装时压掉 Lettuce 的噪音日志 -->
    <logger name="io.lettuce" level="WARN"/>
    <logger name="org.springframework.data.redis" level="WARN"/>

</configuration>
